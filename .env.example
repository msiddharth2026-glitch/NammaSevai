# ==============================================================================
# NammaSevai AI / BharatSevai AI — Production Environment Configuration
# Use placeholders only; NEVER commit production secrets or credentials to Git.
# ==============================================================================

APP_NAME="NammaSevai AI / BharatSevai AI"
APP_ENV="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# Database Settings (Dual Dialect: PostgreSQL for production, SQLite for local)
# ------------------------------------------------------------------------------
# Production PostgreSQL example:
DATABASE_URL="postgresql://bharatsevai_admin:YOUR_DB_PASSWORD@localhost:5432/bharatsevai_prod"
# Local development SQLite default:
# DATABASE_URL="sqlite:///./nammasevai.db"

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Security & Administrative Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
SECRET_KEY="GENERATE_A_CRYPTOGRAPHICALLY_SECURE_SECRET_KEY_FOR_PRODUCTION"
ADMIN_API_KEY="GENERATE_A_STRONG_RANDOM_ADMIN_API_KEY_FOR_OFFICER_AUTH"

# Authorized CORS Origins (Comma-separated URLs, NO wildcards in production)
CORS_ORIGINS="https://bharatsevai.gov.in,https://nammasevai.gov.in"

# ------------------------------------------------------------------------------
# Multi-Provider AI Cascade (Priority Order: OpenAI -> Grok -> Gemini -> Safe Rule Engine)
# Ephemeral queries only; no secrets or citizen PII stored.
# ------------------------------------------------------------------------------
# 1. Primary: OpenAI / ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 2. Secondary: Grok / xAI (https://console.x.ai)
XAI_API_KEY=""
XAI_MODEL="grok-beta"

# 3. Final Fallback: Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Circuit Breaker & Fallback Resilience
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# ------------------------------------------------------------------------------
# Rate Limiting & Denial of Service Protection
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_MATCH_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=40
MAX_REQUEST_BODY_BYTES=5242880
