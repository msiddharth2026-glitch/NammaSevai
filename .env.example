# NammaSevai AI - Environment Variables Template
APP_NAME="NammaSevai AI Backend"
APP_ENV="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/nammasevai_db"

# Security & Admin Authentication
SECRET_KEY="generate-a-secure-random-key-for-production"
ADMIN_API_KEY="generate-a-secure-admin-key"

# Google Gemini AI API Configuration
# Optional: Set GEMINI_API_KEY from https://aistudio.google.com/app/apikey
# If unset, NammaSevai AI defaults to verified Tamil/Tanglish rule matching.
GEMINI_API_KEY=""
